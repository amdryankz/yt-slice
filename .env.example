# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/clipper_db"

# Redis Connection 
REDIS_HOST="localhost"
REDIS_PORT=6379

# API Keys
GEMINI_API_KEY="your_gemini_api_key_here"
DEEPGRAM_API_KEY="your_deepgram_api_key_here" 

# Webshare
# Paste the rotating/backbone proxy URL from the Webshare dashboard.
WEBSHARE_PROXY_URL="http://your-username:your-password@p.webshare.io:80"
# Webshare API key (used only by the web server to display plan bandwidth usage).
WEBSHARE_API_KEY="your_webshare_api_key_here"

# Optional: Mozilla/Netscape cookies file for authenticated YouTube downloads.
# Keep this file outside the repository and set an absolute path readable by the worker.
YTDLP_COOKIES_FILE="/absolute/path/to/youtube-cookies.txt"

# Cloudflare R2 (S3 API)
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
S3_BUCKET_NAME="clipper-clips"
S3_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
